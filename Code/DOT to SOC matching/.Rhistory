fy2024 = fy2024 %>%
mutate(WORKSITE_COUNTY = str_to_title((WORKSITE_COUNTY))) %>%
left_join(geography, by = c("WORKSITE_COUNTY" = "CountyTownName", "WORKSITE_STATE" = "StateAb"))
# check for non-merges. I've caught them all.
fy2024 %>% ungroup() %>% filter(is.na(Area) & !is.na(WORKSITE_COUNTY)) %>% count()
# pull in wage levels and job zones
wage_levels = read.csv(file.path(data_path, "Other Data","OFLC_Wages_2024-25", "ALC_Export.csv")) %>%
mutate(
Level1_full = ifelse(Label !="Annual Wage",  Level1 * 2080, Level1),
Level2_full = ifelse(Label !="Annual Wage",  Level2 * 2080, Level2),
Level3_full = ifelse(Label !="Annual Wage",  Level3 * 2080, Level3),
Level4_full = ifelse(Label !="Annual Wage",  Level4 * 2080, Level4),
Average_full = ifelse(Label !="Annual Wage",  Average * 2080, Average),
Level1_part = ifelse(Label !="Annual Wage",  Level1 * 1040, Level1),
Level2_part = ifelse(Label !="Annual Wage",  Level2 * 1040, Level2),
Level3_part = ifelse(Label !="Annual Wage",  Level3 * 1040, Level3),
Level4_part = ifelse(Label !="Annual Wage",  Level4 * 1040, Level4),
Average_part = ifelse(Label !="Annual Wage",  Average * 1040, Average),
)
unique(wage_levels$Label)
fy2024 = fy2024 %>%
mutate(SocCode = substr(SOC_CODE, 1, 7))  %>%
left_join(wage_levels, by = c("Area", "SocCode")) %>%
mutate(WAGE_LEVEL_NEW_LCA = case_when(
(petition_beneficiary_full_time == "Y" | petition_beneficiary_full_time == "") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level1_full & petition_annual_pay_clean < Level2_full ~ "I",
(petition_beneficiary_full_time == "Y" | petition_beneficiary_full_time == "") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level2_full & petition_annual_pay_clean < Level3_full ~ "II",
(petition_beneficiary_full_time == "Y" | petition_beneficiary_full_time == "") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level3_full & petition_annual_pay_clean < Level4_full ~ "III",
(petition_beneficiary_full_time == "Y" | petition_beneficiary_full_time == "") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level4_full ~ "IV",
(petition_beneficiary_full_time == "Y" | petition_beneficiary_full_time == "") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean < Level1_full ~ "Too Low",
(petition_beneficiary_full_time == "N") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level1_part & petition_annual_pay_clean < Level2_part ~ "I",
(petition_beneficiary_full_time == "N") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level2_part & petition_annual_pay_clean < Level3_part ~ "II",
(petition_beneficiary_full_time == "N") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level3_part & petition_annual_pay_clean < Level4_part ~ "III",
(petition_beneficiary_full_time == "N") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean >= Level4_part ~ "IV",
(petition_beneficiary_full_time == "N") & Label !="High Wage" &  Label !="No Leveled Wage" & petition_annual_pay_clean < Level1_part ~ "Too Low",
TRUE ~ "NA"))
table(fy2024$WAGE_LEVEL_NEW_LCA, fy2024$PW_WAGE_LEVEL)
# there are many NAs here. most likely explanations are:
# (1) wage levels are corresponding to the work site in I-129 rather than LCA
# (2) concerns with adjusting hourly to annual
write.csv(fy2024, file = file.path(cleaned_path, "fy2024_cleaned_ungeocoded.csv"))
# Map using geometry for those with exact matches
test <- read.csv(file = file.path(cleaned_path, "addresses_lookup.csv"))
View(test)
# split into chunks for reader
# parse out addresses for later merge.
df_addresses <- fy2024 %>% ungroup() %>%
select(applicant_id, petition_empl_addr, petition_empl_city, petition_empl_state, petition_worksite_zip,petition_full_address)
chunks <- split(df_addresses, ceiling(seq_along(df_addresses$petition_full_address)/9000))
geocode_chunk <- function(chunk) {
geocode(chunk, address = petition_full_address, method = "census",
lat = latitude, long = longitude, full_results = TRUE)
}
geocoded_list <- map(chunks, geocode_chunk)
geocoded_all <- bind_rows(geocoded_list) %>% select(-id)
zip_cbsa_crosswalk <- read_xlsx(file.path(data_path, "Other Data/ZIP_CBSA_122024.xlsx"))
zip_cbsa_crosswalk <- zip_cbsa_crosswalk %>%
filter(!USPS_ZIP_PREF_STATE %in% c("PR", "VI")) %>%
group_by(ZIP, USPS_ZIP_PREF_STATE) %>%
slice(which.max(TOT_RATIO)) %>% ungroup() %>%
select(ZIP, USPS_ZIP_PREF_STATE, CBSA, USPS_ZIP_PREF_CITY, TOT_RATIO) %>%
rename(state_hud = USPS_ZIP_PREF_STATE, cbsa_hud = CBSA,
cbsa_name_hud = USPS_ZIP_PREF_CITY, matching_ratio_hud = TOT_RATIO)
place_cty_crosswalk <- read_xlsx(file.path(data_path, "Other Data/CDPs-Counties Crosswalk Resource.xlsx"))
place_cty_crosswalk <- place_cty_crosswalk %>%
# Split into place_base and state_fta
tidyr::extract(
col   = PLACE_NAME_FORMATTED,
into  = c("place_base", "state_fta"),
regex = "^(.*?),\\s*([^,]+)\\s*$",
remove = FALSE
) %>%
mutate(
state_fta = str_trim(state_fta),
# remove only trailing lowercase qualifiers, then optional " CDP"
place_name = place_base %>%
str_remove("\\s+(?:city and borough|borough|village|town|city|municipality)$") %>%
str_remove("\\s+CDP$") %>%
str_squish()
) %>%
