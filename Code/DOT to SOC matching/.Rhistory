}
# geocode addressees
fy2024 <- fy2024 %>%
mutate(petition_empl_addr =  replace_num_words(tolower(petition_empl_addr)),
petition_empl_addr = clean_addr(petition_empl_addr),
petition_empl_addr = str_to_title(petition_empl_addr),
petition_empl_city = str_to_title(petition_empl_city),
petition_empl_state = toupper(petition_empl_state),
petition_worksite_zip = str_pad(petition_worksite_zip, pad = "0", width = 5, side = "left")) %>%
# construct full address
mutate(petition_full_address = clean_addr_full(
street = petition_empl_addr,
city   = petition_empl_city,
state  = petition_empl_state,
zip    = petition_worksite_zip
)) %>%
mutate(SOC_TITLE = str_to_title(SOC_TITLE)) #note that this combines the handful of 7 digit SOCs with 9 digit SOCS, where 7 and 9 have the same SOC name.
################################################################################
# Match DOT occupations with SOC occupations for those without SOC codes
# Normalize DOT occupation titles: lowercase, trim, remove punctuation & multiple spaces
normalize_title <- function(x) {
x %>%
str_to_lower() %>%
str_replace_all("[[:punct:]]", " ") %>%
str_squish()
}
# Filter out those with neither DOT code nor job title
fy2024_na_dot_job <- fy2024 %>% filter(petition_beneficiary_dot_occ_code == "" &
petition_beneficiary_dot_title == "")
nrow(fy2024_na_dot_job) / nrow(fy2024) # only 0.1 percent have neither DOT code nor job title, safe to drop
fy2024 <- fy2024 %>% filter(petition_beneficiary_dot_occ_code != "" |
petition_beneficiary_dot_title != "")
# Export for use in machine learning algorithm
write.csv(fy2024 %>%
mutate(job_norm = normalize_title(petition_beneficiary_dot_title)) %>%
filter(!is.na(SOC_CODE)) %>%
mutate(soc_title_norm = normalize_title(SOC_TITLE)) %>%
rename(DOT_category = petition_beneficiary_dot_occ_code,
SOC = SOC_CODE) %>%
select(applicant_id, DOT_category, job_norm, SOC, soc_title_norm,
registration_employer_name, petition_beneficiary_field),
file = file.path(dot_matching_path, "Applicants with SOC codes and titles.csv"),
row.names = FALSE)
write.csv(fy2024 %>%
mutate(job_norm = normalize_title(petition_beneficiary_dot_title)) %>%
filter(is.na(SOC_CODE)) %>%
rename(DOT_category = petition_beneficiary_dot_occ_code) %>%
select(applicant_id, DOT_category, job_norm,
registration_employer_name, petition_beneficiary_field),
file = file.path(dot_matching_path, "Applicants without SOC codes.csv"),
row.names = FALSE)
# Run algorithm trained on existing DOT to SOC matching
setwd(dot_matching_path)
system('python3 dot_soc_matching.py')
fy2024_fitted <- read.csv(file = file.path(dot_matching_path, "Applicants with predicted SOC codes.csv"))
fy2024_fitted <- fy2024_fitted %>% filter(alt1_prob >= 0.95) %>%
select(applicant_id, predicted_SOC_code, predicted_SOC_title, alt1_prob,
DOT_category, job_norm, registration_employer_name, petition_beneficiary_field)
fy2024 <- fy2024 %>%
left_join(fy2024_fitted %>% select(applicant_id, predicted_SOC_code, predicted_SOC_title), by = "applicant_id") %>%
mutate(SOC_CODE = ifelse(is.na(SOC_CODE), predicted_SOC_code, SOC_CODE),
SOC_TITLE = ifelse(is.na(SOC_TITLE), predicted_SOC_title, SOC_TITLE)) %>%
select(-c(predicted_SOC_code, predicted_SOC_title)) %>%
filter(!is.na(SOC_CODE))
################################################################################
# read in state-level regional price parities
rpps = readxl::read_excel(file.path(data_path, "Other Data", "rpp1224.xlsx"), sheet = "Table 2", skip=2)  %>%
select(State = ...1,
deflator = "Goods") %>%
mutate(
state_abbr = ifelse(
State %in% state.name,
state.abb[match(State, state.name)],
ifelse(State == "District of Columbia", "DC", NA)  # handle DC manually
)
) %>% na.omit() %>%
mutate(deflator = 100/deflator) %>% select(state_abbr, deflator)
# note that LCA worksite and I-129 worksites often differ
# as LCAs are submitted prior to the I-129, and cover multiple applicants,
# I-129 form worksites are more likely to be accurate.
fy2024 = fy2024 %>%
left_join(rpps, by  = c("petition_worksite_state" = "state_abbr")) %>%
mutate(petition_annual_pay_clean_rpp_adj = petition_annual_pay_clean*deflator) %>% select(-deflator)
