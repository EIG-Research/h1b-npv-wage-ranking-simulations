rename(county_name = countycountyequivalent, cbsa_fta = cbsacode, cbsa_name_fta = cbsatitle) %>%
select(county_fips, county_name, cbsa_fta, cbsa_name_fta)
place_cty_crosswalk <- place_cty_crosswalk %>%
left_join(cty_msa_crosswalk, by = "county_fips")
View(place_cty_crosswalk)
