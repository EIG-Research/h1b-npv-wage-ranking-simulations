fy_base_sample <- fy_base_sample %>%
left_join(npv_adj_factors, by = join_by("registration_age" == "AGE")) %>%
mutate(
mean_wage_npv_3pct = case_when(
is.na(mean_wage_npv_3pct) & registration_age < 22 ~ first(npv_adj_factors$mean_wage_npv_3pct),
is.na(mean_wage_npv_3pct) & registration_age > 65 ~ last(npv_adj_factors$mean_wage_npv_3pct),
TRUE ~ mean_wage_npv_3pct),
mean_wage_npv_7pct = case_when(
is.na(mean_wage_npv_7pct) & registration_age < 22 ~ first(npv_adj_factors$mean_wage_npv_7pct),
is.na(mean_wage_npv_7pct) & registration_age > 65 ~ last(npv_adj_factors$mean_wage_npv_7pct),
TRUE ~ mean_wage_npv_7pct),
median_wage_npv_3pct = case_when(
is.na(median_wage_npv_3pct) & registration_age < 22 ~ first(npv_adj_factors$median_wage_npv_3pct),
is.na(median_wage_npv_3pct) & registration_age > 65 ~ last(npv_adj_factors$median_wage_npv_3pct),
TRUE ~ median_wage_npv_3pct),
petition_pay_npv_mean_3pct = petition_annual_pay_clean_rpp_adj * (mean_wage_npv_3pct/100),
petition_pay_npv_mean_7pct = petition_annual_pay_clean_rpp_adj * (mean_wage_npv_7pct/100),
petition_pay_npv_median_3pct = petition_annual_pay_clean_rpp_adj * (median_wage_npv_3pct/100),
proj_h1b_mean_wage_total = petition_annual_pay_24_dollars * mean_wage_6yr_proj,
proj_h1b_median_wage_total = petition_annual_pay_24_dollars * median_wage_6yr_proj,
)
# Split sample into graduate degree holders and non-graduate degree holders
non_grad_sample <- fy_base_sample %>%
filter(petition_h1b_type == "B" & !petition_beneficiary_edu_code %in% c("G", "I")) %>%
mutate(sample_flag = "unreserved") %>%
select(-c(mean_wage_npv_3pct, mean_wage_npv_7pct, median_wage_npv_3pct))
grad_sample <- fy_base_sample %>%
filter(petition_h1b_type == "M" |
(petition_h1b_type == "B" & petition_beneficiary_edu_code %in% c("G", "I"))) %>%
mutate(sample_flag = "reserved") %>%
select(-c(mean_wage_npv_3pct, mean_wage_npv_7pct, median_wage_npv_3pct))
grad_unreserv <- nrow(grad_sample %>% filter(petition_h1b_type != "M"))
unreserve_total <- nrow(fy_base_sample %>% filter(petition_h1b_type != "M"))
# Initiate synthetic registration pool size
approval_rate <- nrow(fy_base_sample) / nrow(fy_cleaned)
synth_reg_total <- round(total_regs * approval_rate, 0)
synth_grad_total <- round(20000 + grad_unreserv/unreserve_total * (synth_reg_total - 20000), 0)
synth_non_grad_total <- synth_reg_total - synth_grad_total
remove(fy_cleaned, fy_base_sample)
proposal_sums <- list()
for(i in 1:1000){
# Sample with replacement to create the synthetic populatin
synth_sample <- bind_rows(
slice_sample(grad_sample, n = synth_grad_total, replace = TRUE),
slice_sample(non_grad_sample, n = synth_non_grad_total, replace = TRUE)
) %>% mutate(synth_applicant_id = row_number())
# Current lottery
synth_unres_winners_lottery <- slice_sample(synth_sample, n = 65000, replace = FALSE)
synth_grad_winners_lottery <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_lottery$synth_applicant_id,
sample_flag == "reserved") %>%
slice_sample(., n = 20000, replace = FALSE)
# Proposed rule
synth_unres_winners_proposed <- slice_sample(synth_sample, n = 65000, weight_by = wage_level_weight, replace = FALSE)
synth_grad_winners_proposed <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_proposed$synth_applicant_id,
sample_flag == "reserved") %>%
slice_sample(., n = 20000, weight_by = wage_level_weight, replace = FALSE)
# Unadjusted wage ranking
synth_unres_winners_wage <- synth_sample %>%
arrange(desc(petition_annual_pay_24_dollars)) %>% head(65000)
synth_grad_winners_wage <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_wage$synth_applicant_id,
sample_flag == "reserved") %>%
arrange(desc(petition_annual_pay_24_dollars)) %>% head(20000)
# RPP adjusted wage ranking
synth_unres_winners_rpp <- synth_sample %>%
arrange(desc(petition_annual_pay_clean_rpp_adj)) %>% head(65000)
synth_grad_winners_rpp <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_rpp$synth_applicant_id,
sample_flag == "reserved") %>%
arrange(desc(petition_annual_pay_clean_rpp_adj)) %>% head(20000)
# NPV and RPP adjusted, mean wage 3%
synth_unres_winners_npv_mean_3pt <- synth_sample %>%
arrange(desc(petition_pay_npv_mean_3pct)) %>% head(65000)
synth_grad_winners_npv_mean_3pt <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_npv_mean_3pt$synth_applicant_id,
sample_flag == "reserved") %>%
arrange(desc(petition_pay_npv_mean_3pct)) %>% head(20000)
# NPV and RPP adjusted, mean wage 7%
synth_unres_winners_npv_mean_7pt <- synth_sample %>%
arrange(desc(petition_pay_npv_mean_7pct)) %>% head(65000)
synth_grad_winners_npv_mean_7pt <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_npv_mean_7pt$synth_applicant_id,
sample_flag == "reserved") %>%
arrange(desc(petition_pay_npv_mean_7pct)) %>% head(20000)
# NPV and RPP adjusted, median wage 3%
synth_unres_winners_npv_median_3pt <- synth_sample %>%
arrange(desc(petition_pay_npv_median_3pct)) %>% head(65000)
synth_grad_winners_npv_median_3pt <- synth_sample %>%
filter(!synth_applicant_id %in% synth_unres_winners_npv_median_3pt$synth_applicant_id,
sample_flag == "reserved") %>%
arrange(desc(petition_pay_npv_median_3pct)) %>% head(20000)
proposal_sums[[i]] <- list(
cur_lottery = summarize_winners(bind_rows(synth_grad_winners_lottery, synth_unres_winners_lottery)),
proposed_rule = summarize_winners(bind_rows(synth_grad_winners_proposed, synth_unres_winners_proposed)),
raw_wage_rank = summarize_winners(bind_rows(synth_grad_winners_wage, synth_unres_winners_wage)),
rpp_adj_rank = summarize_winners(bind_rows(synth_grad_winners_rpp, synth_unres_winners_rpp)),
npv_mean_3pt_rank = summarize_winners(bind_rows(synth_grad_winners_npv_mean_3pt, synth_unres_winners_npv_mean_3pt)),
npv_mean_7pt_rank = summarize_winners(bind_rows(synth_grad_winners_npv_mean_7pt, synth_unres_winners_npv_mean_7pt)),
npv_median_3pt_rank = summarize_winners(bind_rows(synth_grad_winners_npv_median_3pt, synth_unres_winners_npv_median_3pt)),
hv_demand = summarize_hv(synth_sample %>% filter(heartland_visa_eligible == 1))
)
remove(synth_sample, synth_grad_winners_lottery, synth_unres_winners_lottery,
synth_grad_winners_proposed, synth_unres_winners_proposed,
synth_grad_winners_wage, synth_unres_winners_wage,
synth_grad_winners_rpp, synth_unres_winners_rpp,
synth_grad_winners_npv_mean_3pt, synth_unres_winners_npv_mean_3pt,
synth_grad_winners_npv_mean_7pt, synth_unres_winners_npv_mean_7pt,
synth_grad_winners_npv_median_3pt, synth_unres_winners_npv_median_3pt)
print(paste0("Year ", year, ", Iteration ", i))
}
simulation_results[[as.character(year)]] <- proposal_sums
}
proposal_sums <- bind_rows(proposal_sums)
View(proposal_sums)
simulation_output <- bind_rows(
proposal_sums$cur_lottery %>% mutate(allocation_method = "current lottery"),
proposal_sums$proposed_rule %>% mutate(allocation_method = "proposed rule"),
proposal_sums$raw_wage_rank %>% mutate(allocation_method = "raw wage ranking"),
proposal_sums$rpp_adj_rank %>% mutate(allocation_method = "RPP adjusted wage ranking"),
proposal_sums$npv_mean_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 3% discount"),
proposal_sums$npv_mean_7pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 7% discount"),
proposal_sums$npv_median_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, median ACS wage 3% discount"),
) %>% select(-year) %>% relocate(allocation_method) %>%
unnest_wider(state_count, names_repair = "check_unique") %>%
group_by(allocation_method) %>%
mutate_all(~replace(., is.na(.), 0)) %>%
summarise_all(~mean(., na.rm = TRUE)) %>%
ungroup() %>% mutate_all(~replace(., is.na(.), 0)) %>%
pivot_longer(cols = -allocation_method, names_to  = "metric", values_to = "value") %>%
pivot_wider(names_from  = allocation_method, values_from = value)
simulation_output <- bind_rows(
proposal_sums$cur_lottery %>% mutate(allocation_method = "current lottery"),
proposal_sums$proposed_rule %>% mutate(allocation_method = "proposed rule"),
proposal_sums$raw_wage_rank %>% mutate(allocation_method = "raw wage ranking"),
proposal_sums$rpp_adj_rank %>% mutate(allocation_method = "RPP adjusted wage ranking"),
proposal_sums$npv_mean_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 3% discount"),
proposal_sums$npv_mean_7pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 7% discount"),
proposal_sums$npv_median_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, median ACS wage 3% discount"),
)
View(simulation_output)
simulation_output <- bind_rows(
proposal_sums$cur_lottery %>% mutate(allocation_method = "current lottery"),
proposal_sums$proposed_rule %>% mutate(allocation_method = "proposed rule"),
proposal_sums$raw_wage_rank %>% mutate(allocation_method = "raw wage ranking"),
proposal_sums$rpp_adj_rank %>% mutate(allocation_method = "RPP adjusted wage ranking"),
proposal_sums$npv_mean_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 3% discount"),
proposal_sums$npv_mean_7pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 7% discount"),
proposal_sums$npv_median_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, median ACS wage 3% discount"),
) %>% select(-year) %>% relocate(allocation_method) %>%
unnest_wider(state_count, names_repair = "check_unique") %>%
group_by(allocation_method) %>%
mutate_all(~replace(., is.na(.), 0)) %>%
summarise_all(~mean(., na.rm = TRUE)) %>%
ungroup() %>% mutate_all(~replace(., is.na(.), 0)) %>%
pivot_longer(cols = -allocation_method, names_to  = "metric", values_to = "value") %>%
pivot_wider(names_from  = allocation_method, values_from = value)
simulation_output <- bind_rows(
proposal_sums$cur_lottery %>% mutate(allocation_method = "current lottery"),
proposal_sums$proposed_rule %>% mutate(allocation_method = "proposed rule"),
proposal_sums$raw_wage_rank %>% mutate(allocation_method = "raw wage ranking"),
proposal_sums$rpp_adj_rank %>% mutate(allocation_method = "RPP adjusted wage ranking"),
proposal_sums$npv_mean_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 3% discount"),
proposal_sums$npv_mean_7pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, mean ACS wage 7% discount"),
proposal_sums$npv_median_3pt_rank %>% mutate(allocation_method = "NPV adjusted wage ranking, median ACS wage 3% discount"),
) %>% select(-year) %>%
relocate(allocation_method) %>%
mutate(state_count = map(state_count, ~{
x <- .x
if (is.null(x) || (length(x) == 1 && is.na(x))) return(setNames(numeric(0), character(0)))
x <- unlist(x, recursive = TRUE, use.names = TRUE)
# keep only entries with nonempty names
keep <- !is.na(names(x)) & names(x) != ""
x[keep]
})
) %>%
unnest_wider(state_count, names_repair = "check_unique") %>%
group_by(allocation_method) %>%
mutate_all(~replace(., is.na(.), 0)) %>%
summarise_all(~mean(., na.rm = TRUE)) %>%
ungroup() %>% mutate_all(~replace(., is.na(.), 0)) %>%
pivot_longer(cols = -allocation_method, names_to  = "metric", values_to = "value") %>%
pivot_wider(names_from  = allocation_method, values_from = value)
View(simulation_output)
write.csv(simulation_output, file.path(cleaned_path, "simulation_output_v2.csv"))
rm(list = ls())
# load libraries
library(readxl)
library(dplyr)
library(slider)
library(tidyr)
library(tools)
library(spatstat)
library(ipumsr)
library(tidycensus)
library(stringr)
library(purrr)
# set project paths
user_path = "/Users/jiaxinhe/Documents/projects"
project_path = file.path(user_path, "H-1B Bloomberg FOIA")
data_path = file.path(project_path, "Data")
foia_path = file.path(data_path, "FOIA Data")
lca_path = file.path(data_path, "LCA Data")
cleaned_path = file.path(project_path, "Cleaned Data")
################################################################################
# Calculate NPV based on different methods
ddi_acs <- read_ipums_ddi(file.path(data_path, "Other Data/usa_00062.xml"))
acs <- read_ipums_micro(ddi_acs)
acs_age_wage <- acs %>% filter(AGE <= 71) %>%
mutate(AGE = ifelse(AGE < 22, 22, AGE)) %>%
group_by(YEAR, AGE) %>%
summarise(n_obs = n(),
mean_wage = weighted.mean(INCWAGE, PERWT),
mean_income = weighted.mean(INCTOT, PERWT),
median_wage = weighted.median(INCWAGE, PERWT),
median_income = weighted.median(INCTOT, PERWT))
beta3 <- 1 / 1.03
beta7 <- 1 / 1.07
acs_npv_indices <- acs_age_wage %>%
mutate(mean_wage_index = mean_wage / first(mean_wage),
mean_income_index = mean_income / first(mean_income),
median_wage_index = median_wage / first(median_wage),
median_income_index = median_income / first(median_income)) %>%
group_by(YEAR) %>%
mutate(
mean_w_next6 = slide_dbl(mean_wage_index, sum, .after = 6, .complete = TRUE) - mean_wage_index,
mean_wage_6yr_proj = mean_w_next6 / mean_wage_index,
mean_wage_6yr_proj = ifelse(is.infinite(mean_wage_6yr_proj), NA, mean_wage_6yr_proj),
median_w_next6 = slide_dbl(median_wage_index, sum, .after = 6, .complete = TRUE) - median_wage_index,
median_wage_6yr_proj = median_w_next6 / median_wage_index,
median_wage_6yr_proj = ifelse(is.infinite(median_wage_6yr_proj), NA, median_wage_6yr_proj)
) %>%
ungroup() %>% filter(AGE <= 65) %>%
select(-c(mean_w_next6, median_w_next6)) %>%
group_by(YEAR) %>%
mutate(mean_wage_npv_3pct = rev(accumulate(rev(mean_wage_index), ~ .y + beta3 * .x)),
mean_wage_npv_7pct = rev(accumulate(rev(mean_wage_index), ~ .y + beta7 * .x)),
mean_income_npv_3pct = rev(accumulate(rev(mean_income_index), ~ .y + beta3 * .x)),
mean_income_npv_7pct = rev(accumulate(rev(mean_income_index), ~ .y + beta7 * .x)),
median_wage_npv_3pct = rev(accumulate(rev(median_wage_index), ~ .y + beta3 * .x)),
median_wage_npv_7pct = rev(accumulate(rev(median_wage_index), ~ .y + beta7 * .x)),
median_income_npv_3pct = rev(accumulate(rev(median_income_index), ~ .y + beta3 * .x)),
median_income_npv_7pct = rev(accumulate(rev(median_income_index), ~ .y + beta7 * .x)))
max_npv_age <- acs_npv_indices %>% filter(YEAR == 2023)
max_npv_age <- data.frame(
Method = c(
"Mean wage and salary, 3% discount rate",
"Mean total income, 3% discount rate",
"Median wage and salary, 3% discount rate",
"Median total income, 3% discount rate",
"Mean wage and salary, 7% discount rate",
"Mean total income, 7% discount rate",
"Median wage and salary, 7% discount rate",
"Median total income, 7% discount rate"
),
`Peak NPV age` = c(
max_npv_age$AGE[which.max(max_npv_age$mean_wage_npv_3pct)],
max_npv_age$AGE[which.max(max_npv_age$mean_income_npv_3pct)],
max_npv_age$AGE[which.max(max_npv_age$median_wage_npv_3pct)],
max_npv_age$AGE[which.max(max_npv_age$median_income_npv_3pct)],
max_npv_age$AGE[which.max(max_npv_age$mean_wage_npv_7pct)],
max_npv_age$AGE[which.max(max_npv_age$mean_income_npv_7pct)],
max_npv_age$AGE[which.max(max_npv_age$median_wage_npv_7pct)],
max_npv_age$AGE[which.max(max_npv_age$median_income_npv_7pct)]
)
)
max_npv_age
write.csv(acs_npv_indices,
file.path(cleaned_path, "ACS 2021-23 NPV Projections.csv"),
row.names = FALSE)
################################################################################
# Clean and export RPP
rpps <- read.csv(file.path(data_path, "Other Data/SARPP_STATE_2008_2023.csv"))
rpps_cleaned <- rpps %>% filter(LineCode == 1, GeoName != "United States") %>%
rename(state_name = GeoName) %>%
mutate(state_fips = substr(str_trim(GeoFIPS), 1, 2),
state_abbr = ifelse(state_name %in% state.name,
state.abb[match(state_name, state.name)],
ifelse(state_name == "District of Columbia", "DC", NA))) %>%
select(state_fips, state_abbr, state_name, X2021, X2022, X2023) %>%
pivot_longer(cols = -c(state_fips, state_abbr, state_name),
names_to = "Year", values_to = "deflator") %>%
mutate(Year = as.numeric(substr(Year, 2, 5)),
deflator = 100/deflator) %>%
relocate(Year) %>% arrange(Year, state_abbr)
write.csv(rpps_cleaned,
file.path(cleaned_path, "RPP 2021-23 Deflators.csv"),
row.names = FALSE)
View(acs_npv_indices)
rm(list = ls())
