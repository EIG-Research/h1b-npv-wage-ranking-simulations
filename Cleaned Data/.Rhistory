summarize_winners <- function(df) {
df %>%
summarise(
year = year,
avg_age = mean(registration_age, na.rm = TRUE),
share_F1 = mean(petition_prev_status == "F1", na.rm = TRUE),
share_F1_ba = mean(petition_beneficiary_edu_code == "F" & petition_prev_status == "F1", na.rm = TRUE),
share_F1_grad = mean(petition_beneficiary_edu_code %in% c("G", "H", "I") & petition_prev_status == "F1", na.rm = TRUE),
share_no_prev_status = mean(petition_prev_status == "", na.rm = TRUE),
share_outsourcers = mean(large_outsourcer == 1, na.rm = TRUE),
# Wage level shares
share_level1 = mean(wage_level_combined == "I", na.rm = TRUE),
share_level2 = mean(wage_level_combined == "II", na.rm = TRUE),
share_level3 = mean(wage_level_combined == "III", na.rm = TRUE),
share_level4 = mean(wage_level_combined == "IV", na.rm = TRUE),
# Pay
median_pay = median(petition_annual_pay_24_dollars, na.rm=TRUE),
min_pay = min(petition_annual_pay_24_dollars,na.rm=TRUE),
tenth_pct_pay = quantile(petition_annual_pay_24_dollars, 0.10, na.rm = TRUE),
mean_6yr_pay_mean_wage_method = mean(proj_h1b_mean_wage_total, na.rm = TRUE),
mean_6yr_pay_median_wage_method = mean(proj_h1b_median_wage_total, na.rm = TRUE),
# Occupation and firm industry
share_stem = mean(stem_occ, na.rm = TRUE),
share_emp_manu = mean(emp_manu, na.rm = TRUE),
share_emp_it = mean(emp_info_tech, na.rm = TRUE),
share_emp_research_eng = mean(emp_research_eng, na.rm = TRUE),
# Geography
state_count = list(table(petition_worksite_state))
)
}
summarize_hv <- function(df){
df %>%
summarise(
avg_age = mean(registration_age, na.rm = TRUE),
share_F1 = mean(petition_prev_status == "F1", na.rm = TRUE),
share_F1_grad = mean(petition_beneficiary_edu_code %in% c("G", "H", "I") & petition_prev_status == "F1", na.rm = TRUE),
median_pay = median(petition_annual_pay_24_dollars, na.rm=TRUE),
tenth_pct_pay = quantile(petition_annual_pay_24_dollars, 0.10, na.rm = TRUE),
mean_6yr_pay_mean_wage_method = mean(proj_h1b_mean_wage_total, na.rm = TRUE),
# Occupation and firm industry
share_stem = mean(stem_occ, na.rm = TRUE),
share_emp_manu = mean(emp_manu, na.rm = TRUE),
share_emp_it = mean(emp_info_tech, na.rm = TRUE),
# Geography
occ_count = list(table(occ_sector)),
ind_count = list(table(emp_sector)),
state_count = list(table(petition_worksite_state))
)
}
simulation_results <- list()
rm(list = ls())
